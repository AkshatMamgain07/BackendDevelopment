/* ============================================================
   styles.css — EXTERNAL CSS (Type 3)
   Linked into index.html with <link rel="stylesheet" href="styles.css">
   ============================================================ */

/* Objective 1: proof this file is external CSS working */
.external-note {
  color: #5fe0d4;
  font-weight: 600;
}

/* ------------------------------------------------------------
   Objective 2 & 4: Element, Class, and ID selectors
   ------------------------------------------------------------ */
.selector-demo p {          /* element selector (scoped inside .selector-demo) */
  color: #cfd3f7;
}
.sel-class {                 /* class selector — reusable, can be applied to many tags */
  color: #ffd479;
  font-weight: 600;
}
#sel-id {                    /* ID selector — must be unique on the page */
  color: #6bffb8;
  font-weight: 700;
}

/* ------------------------------------------------------------
   Objective 5: Box Model (content, padding, border, margin)
   ------------------------------------------------------------ */
.box-model-wrap {
  display: flex;
  justify-content: center;
  padding: 10px 0;
}
.box-margin {
  background: #33376b;
  padding: 20px;
  border-radius: 6px;
  text-align: center;
  color: #a3abf7;
  font-size: 0.8rem;
}
.box-border {
  background: #2c2f5c;
  border: 4px solid #ffd479;
  padding: 16px;
  border-radius: 6px;
  color: #ffd479;
  font-size: 0.8rem;
}
.box-padding {
  background: #0d0f20;
  padding: 20px;
  border-radius: 4px;
  color: #9ff2c0;
  font-size: 0.8rem;
}
.box-content {
  background: #7c85f0;
  color: #0d0f20;
  padding: 18px 26px;
  border-radius: 4px;
  font-weight: 700;
}

/* ------------------------------------------------------------
   Objective 6: Flexbox layout
   ------------------------------------------------------------ */
.flex-demo {
  display: flex;
  gap: 12px;
  margin: 14px 0 24px;
}
.flex-item {
  flex: 1;
  background: #7c85f0;
  color: #0d0f20;
  font-weight: 700;
  text-align: center;
  padding: 22px 0;
  border-radius: 8px;
}

/* Objective 6: Grid layout */
.grid-demo {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.grid-item {
  background: #2c2f5c;
  border: 1px solid #ffd479;
  color: #ffd479;
  text-align: center;
  padding: 22px 0;
  font-weight: 700;
  border-radius: 8px;
}

/* ------------------------------------------------------------
   Objective 3: Responsive design (media query)
   ------------------------------------------------------------ */
.responsive-demo {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}
.resp-card {
  background: #0d0f20;
  border: 1px solid #33376b;
  color: #eef0fb;
  padding: 30px 0;
  text-align: center;
  border-radius: 8px;
}

/* Below 700px width: collapse the 3-column layout to 1 column */
@media (max-width: 700px) {
  .responsive-demo {
    grid-template-columns: 1fr;
  }
  .grid-demo {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* ------------------------------------------------------------
   Objective 8: Transitions & Animations
   ------------------------------------------------------------ */
.transition-btn {
  background: #7c85f0;
  color: #0d0f20;
  border: none;
  padding: 12px 26px;
  font-size: 1rem;
  font-weight: 700;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.35s ease, transform 0.35s ease, border-radius 0.35s ease;
}
.transition-btn:hover {
  background: #ffd479;
  transform: scale(1.08);
  border-radius: 20px;
}

.animate-box {
  width: 60px;
  height: 60px;
  background: #6bffb8;
  border-radius: 10px;
  margin-top: 14px;
  animation: float-spin 3s ease-in-out infinite;
}

@keyframes float-spin {
  0%   { transform: translateY(0) rotate(0deg);   border-radius: 10px; }
  50%  { transform: translateY(-20px) rotate(180deg); border-radius: 50%; }
  100% { transform: translateY(0) rotate(360deg); border-radius: 10px; }
}
